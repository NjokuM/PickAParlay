# Copy this file to .env and fill in your key
# Get a free key at https://the-odds-api.com (500 credits/month on free tier)
ODDS_API_KEY=your_odds_api_key_here

# Optional: a pool of keys for automatic rotation (comma-separated, no spaces
# needed — they're trimmed). odds_api.py always uses whichever key in the
# pool has the most credits remaining, and marks a key exhausted on a 403.
#
# A normal NBA night costs ~9 credits/game (8 for props + 1 for the spread),
# so an 8-10 game slate is ~70-90 credits per refresh. The scheduled refresh
# runs twice a day (06:20 + 18:00 London in backend/app.py), so a single
# 500-credit/month free key lasts roughly 3 days on its own. Each extra free
# key added here buys a few more days before you're back to zero across the
# whole pool — it does not make the monthly budget sustainable by itself.
# If ODDS_API_KEYS is set, it takes priority over ODDS_API_KEY above.
# ODDS_API_KEYS=key_one,key_two,key_three
