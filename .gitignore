# Environment & secrets
.env

# Cache (runtime data, not source)
.cache/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env.local

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Claude dev config (local only) — except checked-in, shareable skills.
# Note: a plain ".claude/" exclusion stops git from ever looking inside it,
# so later "!" negations for paths underneath would be silently ignored —
# ".claude/*" (not "/") is required for the negations below to actually work.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/pick-analysis/

# SQLite database (runtime data, not source)
*.db
*.db-shm
*.db-wal

# Next.js build artifacts
frontend/.next/
frontend/node_modules/
